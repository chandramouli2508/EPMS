# ===========================
# EPMS — Root .env.example
# ===========================
# Copy to .env for local development. Never commit .env.

# ─── Application ──────────────────────────────────────────────────────────────
# URL the browser reaches the web app on (used for CORS and cookie origin)
APP_URL=http://localhost:5173

# NestJS API listen port
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16 connection string
DATABASE_URL=postgresql://epms_user:epms_pass@localhost:5432/epms_dev

# Test database (used by Jest integration tests)
DATABASE_TEST_URL=postgresql://epms_user:epms_pass@localhost:5432/epms_test

# ─── Authentication ───────────────────────────────────────────────────────────
# RS256 key pair. Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then base64-encode and paste here:
#   [System.Convert]::ToBase64String([System.IO.File]::ReadAllBytes("private.pem"))
JWT_PRIVATE_KEY_BASE64=<base64-encoded-RS256-private-key>
JWT_PUBLIC_KEY_BASE64=<base64-encoded-RS256-public-key>

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime in days (stored in DB; cookie max-age matches)
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis used by BullMQ for Excel import/export jobs
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── Storage ──────────────────────────────────────────────────────────────────
# StorageProvider interface only — no implementation in Phase 0.
# Uncomment and fill in when storage is added.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=epms-documents
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_REGION=us-east-1

# ─── Log Level ────────────────────────────────────────────────────────────────
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Phase 1: Identity & Auth Configuration ──────────────────────────────────
# Admin seed credentials (required for prisma:seed)
SEED_ADMIN_EMAIL=admin@epms.local
SEED_ADMIN_PASSWORD=TempPassword123!@#

# Security & Session policies
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_SESSIONS=5
AUTH_TEMP_PASSWORD_HOURS=72

# Full-stack Docker (root docker-compose.yml)
WEB_PORT=8080
DOCKER_APP_URL=http://localhost:8080
DOCKER_NODE_ENV=development


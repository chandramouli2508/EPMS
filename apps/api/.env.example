# apps/api/.env.example
# Copy to apps/api/.env for local API development.
# All variables are also documented in the root .env.example.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
LOG_LEVEL=info

DATABASE_URL=postgresql://epms_user:epms_pass@localhost:5432/epms_dev
DATABASE_TEST_URL=postgresql://epms_user:epms_pass@localhost:5432/epms_test

# Base64-encoded RS256 PEM private key (generate: openssl genrsa -out private.pem 2048)
JWT_PRIVATE_KEY_BASE64=
# Base64-encoded RS256 PEM public key (generate: openssl rsa -in private.pem -pubout -out public.pem)
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

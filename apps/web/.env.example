# apps/web/.env.example
# Copy to apps/web/.env for local development.
# VITE_ prefix required for Vite to expose variables to the browser bundle.

# API base URL. Use a relative path so the Vite dev proxy forwards requests to
# the NestJS server on localhost:3000, and the same relative path works behind
# Nginx in production — no cross-origin issues in either environment.
VITE_API_BASE_URL=/api/v1
